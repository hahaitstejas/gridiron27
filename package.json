{
  "name": "gridiron27",
  "version": "0.1.0",
  "private": true,
  "description": "Gridiron 27 - an original browser 3D American football game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline && node tools/offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "node tools/autosim.js",
    "games": "node tools/gamesim.js",
    "bot": "node tools/humanbot.js",
    "fuzz": "node tools/fuzz.js",
    "export-league": "node tools/export-league.js",
    "fetch-faces": "node tools/fetch-faces.mjs",
    "app": "vite build --mode app && electron .",
    "app:build": "node tools/app-build.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/saira-condensed": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.0",
    "meshoptimizer": "^0.22.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.gridiron27.game",
    "productName": "Gridiron 27",
    "copyright": "Gridiron 27",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist-app/**",
      "tools/remote-images.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.sports-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Gridiron 27"
    }
  }
}
